<?xml version="1.0"?>
<Container version="2">
  <Name>hotspot-dashboard</Name>
  <Repository>hotspot-dashboard:latest</Repository>
  <Registry/>
  <!-- Network=host (changed from "bridge"), a deliberate tradeoff, not a
       default: openSPOT4 hotspots can be reached by their mDNS ".local"
       hostname (confirmed live: the device runs its own mDNS responder
       and this app has no static-IP requirement for that field), but
       mDNS depends on multicast UDP reaching the real LAN, which Docker's
       default bridge network does not reliably pass through. Host mode
       shares the Unraid box's own network stack directly instead of NAT,
       so a ".local" name in the hotspot IP field resolves the same way
       it would for any other program running directly on the host. Real
       cost: this container no longer has its own isolated port space,
       so whatever it binds (5000, 2237/udp) must not collide with
       anything else already running on the host, and there's no
       port-remapping safety net if it does. If that tradeoff isn't worth
       it for a given install, "bridge" plus a DHCP reservation on the
       openSPOT4 (a static IP, but managed by the router instead of this
       app) is the equivalent fix with none of this cost. See the
       WebUI/Edit label gotchas already documented in this project's
       history with Unraid-specific template quirks before assuming this
       Network value renders/behaves identically to bridge in every other
       respect. -->
  <Network>host</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support/>
  <Project/>
  <Overview>Live status dashboard for a fleet of Pi-Star / WPSD ham radio hotspots, polled over SSH every few seconds for uptime, temperature, signal, and active-call info.</Overview>
  <Category>Network:Other</Category>
  <WebUI>http://[IP]:5000/</WebUI>
  <TemplateURL/>
  <Icon/>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <!-- No Port-type Config entries here anymore. A Port config's whole
       purpose is editing a bridge-mode host<->container port MAPPING,
       which doesn't exist under Network=host (the container's own ports
       ARE the host's ports directly, always 5000/2237, not editable via
       a mapping). The dashboard still listens on 5000, and the optional
       WSJT-X UDP feature still expects 2237 to match its own Settings
       toggle, both fixed values now, not configurable via this
       template. -->
  <Config Name="App Data" Target="/app/data" Default="/mnt/user/appdata/hotspot-dashboard" Mode="rw" Description="Persistent storage for hotspots.json" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/hotspot-dashboard</Config>
  <Config Name="Poll Interval" Target="POLL_INTERVAL" Default="5" Mode="" Description="Seconds between fleet polling sweeps" Type="Variable" Display="always" Required="false" Mask="false">5</Config>
  <Config Name="SSH Timeout" Target="SSH_TIMEOUT" Default="5" Mode="" Description="SSH connection timeout in seconds" Type="Variable" Display="always" Required="false" Mask="false">5</Config>
  <Config Name="Failure Threshold" Target="FAILURE_THRESHOLD" Default="2" Mode="" Description="Consecutive failed polls before a hotspot is marked Offline" Type="Variable" Display="always" Required="false" Mask="false">2</Config>
  <Config Name="Max Workers" Target="MAX_WORKERS" Default="5" Mode="" Description="Parallel SSH checks per polling sweep" Type="Variable" Display="advanced" Required="false" Mask="false">5</Config>
  <Config Name="Active Timeout" Target="ACTIVE_TIMEOUT" Default="30" Mode="" Description="Seconds of log silence before a node is forced back to idle. Set to 0 to disable." Type="Variable" Display="advanced" Required="false" Mask="false">30</Config>
  <Config Name="QRZ Username" Target="QRZ_USERNAME" Default="" Mode="" Description="QRZ.com username, for looking up active caller name/city/state. Leave blank to disable." Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="QRZ Password" Target="QRZ_PASSWORD" Default="" Mode="" Description="QRZ.com password (requires an active XML subscription to see other callsigns' info)" Type="Variable" Display="always" Required="false" Mask="true"></Config>
</Container>
